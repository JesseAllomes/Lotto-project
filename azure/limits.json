{
  "_note": "Owner-approved limits read by tools/cost_guard.py. Raising any number or adding to any list is a loosening: the guard fails it (check C10) unless LIMITS_APPROVED=1. Costs: budget_s_per_run is the average billed seconds of a run (default: the full replicaTimeout); budget_usd_month.total is checked against it, hard_ceiling_all_timeouts against every run using its whole timeout. Prices are USD list prices, without the free monthly grant. lotto-actions is the only Event job: max_runs_per_day is the cost model's assumption (KEDA starts at most `event.max_executions` per polling interval and each run drains up to code.max_actions_per_run messages).",
  "prices": {
    "aca_vcpu_s": 2.4e-05,
    "aca_gib_s": 3e-06
  },
  "budget_usd_month": {
    "total": 15,
    "hard_ceiling_all_timeouts": 27
  },
  "image_repository": "ghcr.io/jesseallomes/lotto-azure-runner",
  "jobs": {
    "lotto-draws": {
      "trigger": "Schedule",
      "max_runs_per_day": 1,
      "min_interval_min": 1440,
      "max_replica_timeout_s": 1800,
      "max_cpu": 0.5,
      "max_memory_gi": 1,
      "parallelism": 1,
      "replica_completion_count": 1,
      "replica_retry_limit": 0,
      "may_hold_secrets": []
    },
    "lotto-jackpots": {
      "trigger": "Schedule",
      "max_runs_per_day": 1,
      "min_interval_min": 1440,
      "max_replica_timeout_s": 1800,
      "max_cpu": 0.5,
      "max_memory_gi": 1,
      "parallelism": 1,
      "replica_completion_count": 1,
      "replica_retry_limit": 0,
      "may_hold_secrets": [
        "GITHUB_TOKEN"
      ]
    },
    "lotto-comps": {
      "trigger": "Schedule",
      "max_runs_per_day": 1,
      "min_interval_min": 1440,
      "max_replica_timeout_s": 5400,
      "max_cpu": 0.5,
      "max_memory_gi": 1,
      "parallelism": 1,
      "replica_completion_count": 1,
      "replica_retry_limit": 0,
      "may_hold_secrets": [
        "ENTRANT_PROFILE_JSON"
      ]
    },
    "lotto-entries": {
      "trigger": "Schedule",
      "max_runs_per_day": 120,
      "min_interval_min": 5,
      "max_replica_timeout_s": 280,
      "budget_s_per_run": 120,
      "max_cpu": 0.5,
      "max_memory_gi": 1,
      "parallelism": 1,
      "replica_completion_count": 1,
      "replica_retry_limit": 0,
      "may_hold_secrets": [
        "ENTRANT_PROFILE_JSON"
      ],
      "max_env": {
        "ENTRANT_CONCURRENCY": 3,
        "ENTRANT_TIMEOUT_S": 150
      }
    },
    "lotto-site": {
      "trigger": "Schedule",
      "max_runs_per_day": 12,
      "min_interval_min": 120,
      "max_replica_timeout_s": 900,
      "budget_s_per_run": 300,
      "max_cpu": 0.5,
      "max_memory_gi": 1,
      "parallelism": 1,
      "replica_completion_count": 1,
      "replica_retry_limit": 0,
      "may_hold_secrets": [
        "SWA_DEPLOY_TOKEN"
      ]
    },
    "lotto-reenter": {
      "trigger": "Manual",
      "max_runs_per_day": 2,
      "min_interval_min": 1,
      "max_replica_timeout_s": 600,
      "max_cpu": 0.5,
      "max_memory_gi": 1,
      "parallelism": 1,
      "replica_completion_count": 1,
      "replica_retry_limit": 0,
      "may_hold_secrets": [
        "GITHUB_TOKEN",
        "ENTRANT_PROFILE_JSON"
      ],
      "max_env": {
        "ENTRANT_CONCURRENCY": 3,
        "ENTRANT_TIMEOUT_S": 150
      }
    },
    "lotto-actions": {
      "trigger": "Event",
      "max_runs_per_day": 8,
      "min_interval_min": 1,
      "max_replica_timeout_s": 600,
      "budget_s_per_run": 180,
      "max_cpu": 0.5,
      "max_memory_gi": 1,
      "parallelism": 1,
      "replica_completion_count": 1,
      "replica_retry_limit": 0,
      "may_hold_secrets": [
        "ENTRANT_PROFILE_JSON"
      ],
      "max_env": {
        "ENTRANT_CONCURRENCY": 3,
        "ENTRANT_TIMEOUT_S": 150
      },
      "event": {
        "max_executions": 1,
        "min_polling_interval_s": 60,
        "rule_types": [
          "azure-queue"
        ],
        "queues": [
          "lotto-actions"
        ],
        "accounts": [
          "stlottoactions"
        ]
      }
    }
  },
  "allowed_resource_types": [
    "Microsoft.App/jobs",
    "Microsoft.App/managedEnvironments",
    "Microsoft.ManagedIdentity/userAssignedIdentities",
    "Microsoft.KeyVault/vaults",
    "Microsoft.Storage/storageAccounts",
    "Microsoft.Web/sites",
    "Microsoft.Web/serverfarms",
    "Microsoft.Web/staticSites",
    "Microsoft.CognitiveServices/accounts"
  ],
  "log_analytics_max_daily_gb": 0.5,
  "workflows": {
    "max_timeout_minutes": 300,
    "max_cron_fires_per_day": 300,
    "concurrency_exempt": [
      "probe.yml"
    ]
  },
  "code": {
    "max_issue_pages": 10,
    "max_retry_loop": 5,
    "comps_max_new": 300,
    "runner_entrant_concurrency": 3,
    "runner_entrant_timeout_s": 150,
    "entrant_default_max": 200,
    "entrant_default_concurrency": 6,
    "max_actions_per_run": 20,
    "actions_max_dequeue": 3
  },
  "ratchet": {
    "unbounded_subprocess": 0,
    "unbounded_while": 0,
    "self_dispatch_workflows": [
      "entries.yml"
    ],
    "workflow_run_allowed": {
      "site.yml": [
        "comps",
        "entries"
      ]
    }
  },
  "site_api": {
    "allowed_routes": [
      "/api/action"
    ],
    "allowed_methods": [
      "POST"
    ],
    "rate_limit_max_actions": 30,
    "min_rate_window_s": 600,
    "api_runtime": "python:3.11",
    "max_body_bytes": 16384,
    "max_ids": 50,
    "max_answer_chars": 2000,
    "allowed_kinds": [
      "remove",
      "broken",
      "reenter",
      "answer",
      "done",
      "undone"
    ],
    "retired_workflows": [
      "reenter.yml",
      "remove.yml",
      "answer.yml"
    ]
  }
}
