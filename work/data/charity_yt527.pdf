<style>
  /* =============================================================
   DESIGN TOKENS
   All custom properties in one place instead of split across the file.
============================================================= */
  :root {
    /* Base colour palette — every value here repeats at least twice
     across the file. Component rules should reference these (or the
     semantic aliases below) rather than hard-coding hex values. */
    --yt-color-primary: #5f259f; /* Purple — buttons, footer social icons, gradients */
    --yt-color-primary-dark: #4a1d7a; /* Darkened primary — hover feedback */
    --yt-color-primary-light: #7c3aed; /* Lightened primary — visited links */
    --yt-color-secondary: #df2a60; /* Pink/magenta — secondary buttons, CTA pills, gradients */
    --yt-color-tertiary: #4559a7; /* Blue — tertiary buttons */
    --yt-color-white: #ffffff;
    --yt-color-black: #000000;

    /* Semantic aliases */
    --yt-link-color: var(--yt-color-primary);
    --yt-link-color-hover: var(--yt-color-primary-dark);
    --yt-link-color-visited: var(--yt-color-primary-light);

    /* Accessibility-control tokens — shared by .back-to-top and .skip-link
     TODO: replace with theme colour variables on merge. */
    --a11y-control-bg: #262a34;
    --a11y-control-bg-hover: #4a577a;
    --a11y-control-color: var(--yt-color-white);
    --a11y-focus-ring-inner: #958cd3;
    --a11y-focus-ring-outer: var(--yt-color-white);
  }

  /* =============================================================
   GLOBAL FOCUS RING
   Base focus-visible treatment for links/buttons. Component-specific
   focus overrides live with their component below.
============================================================= */
  a:focus-visible,
  button.nav-items-left__item:focus-visible,
  button.utility-nav__item:focus-visible {
    outline-width: 3px !important;
    outline-style: solid !important;
    outline-offset: 4px !important;
    border-radius: 4px;
  }

  /* =============================================================
   TYPOGRAPHY
============================================================= */
  html {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  b,
  strong {
    font-weight: 600;
  }

  .text-white,
  .text-white * {
    color: var(--yt-color-white) !important;
  }

  /* Headings — h1/h2 */
  .yourtown .yt-h1,
  .yourtown h1,
  .yourtown .yt-h2,
  .yourtown h2,
  .yourtown h1,
  .yourtown h1 *,
  .yourtown h2,
  .yourtown h2 * {
    font-family: Poppins, serif;
    font-weight: 600;
  }

  .yourtown .yt-h2,
  .yourtown h2 {
    font-size: 2.25em; /* default is 2em */
    color: #3d3e44;
  }

  /* Headings — h3 */
  .yourtown .yt-h3,
  .yourtown h3,
  .yourtown .yt-h3 *,
  .yourtown h3 * {
    font-weight: 500;
    color: var(--yt-link-color-hover);
  }

  /* Spacing between stacked heading levels and preceding content */
  p + h2,
  ul + h2 {
    margin-top: 1.5em;
  }

  p + h3 {
    margin-top: 1em;
  }

  /* =============================================================
   LINKS
============================================================= */

  /* ---------------------------------------------------------------------------
   Body copy links
   Excludes the yt-btn utility class and its modifier variants (e.g.
   yt-btn--primary), which get their own styling under BUTTONS below.
   --------------------------------------------------------------------------- */

  /* Default state */
  .yourtown a:not([class^="yt-btn"]):not([class*=" yt-btn"]) {
    color: var(--yt-link-color);
    text-decoration: underline;
  }

  /* Hover state */
  .yourtown a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover {
    color: var(--yt-link-color-hover);
    text-decoration-thickness: 1px;
  }

  /* Visited state */
  .yourtown a:not([class^="yt-btn"]):not([class*=" yt-btn"]):visited {
    color: var(--yt-link-color-visited);
  }

  /* Focus-visible state — keyboard and assistive technology focus ring.
   Colour intentionally omitted — browser default focus colour applies. */
  .yourtown a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible {
    outline-width: 3px !important;
    outline-style: solid !important;
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Links inside text-colour utility wrappers inherit that colour */
  .yourtown .yt-text-primary a:not([class^="yt-btn"]):not([class*=" yt-btn"]),
  .yourtown
    .yt-text-secondary
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]) {
    color: inherit;
    text-decoration: underline;
  }

  .yourtown
    .yt-text-primary
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover,
  .yourtown
    .yt-text-secondary
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover {
    color: var(--yt-link-color-hover);
    text-decoration-thickness: 2px;
  }

  /* ---------------------------------------------------------------------------
   Links within headings
   Links inside h1-h6 inherit the heading colour rather than using the link
   colour. Underline is removed by default since headings typically handle
   their own styling. Focus ring is retained for accessibility.
   --------------------------------------------------------------------------- */

  /* Default state */
  .yourtown h1 a:not([class^="yt-btn"]):not([class*=" yt-btn"]),
  .yourtown h2 a:not([class^="yt-btn"]):not([class*=" yt-btn"]),
  .yourtown h3 a:not([class^="yt-btn"]):not([class*=" yt-btn"]),
  .yourtown h4 a:not([class^="yt-btn"]):not([class*=" yt-btn"]),
  .yourtown h5 a:not([class^="yt-btn"]):not([class*=" yt-btn"]),
  .yourtown h6 a:not([class^="yt-btn"]):not([class*=" yt-btn"]) {
    color: inherit;
    text-decoration: none;
  }

  /* Hover state */
  .yourtown h1 a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown h1 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover,
  .yourtown h2 a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown h2 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover,
  .yourtown h3 a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown h3 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover,
  .yourtown h4 a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown h4 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover,
  .yourtown h5 a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown h5 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover,
  .yourtown h6 a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown h6 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Focus-visible state */
  .yourtown h1 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible,
  .yourtown h2 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible,
  .yourtown h3 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible,
  .yourtown h4 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible,
  .yourtown h5 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible,
  .yourtown h6 a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible {
    outline-width: 3px !important;
    outline-style: solid !important;
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ---------------------------------------------------------------------------
   Links within background colour/gradient sections (yt-bg-*)
   Links inside yt-bg-* containers inherit the section text colour rather than
   using the standard link colour, preventing contrast/clash issues on
   non-white backgrounds. Visited state also inherits to avoid the purple
   visited colour clashing with darker or saturated backgrounds.

   REFACTOR NOTE: the original file listed every yt-bg-* modifier
   (yt-bg-primary, yt-bg-secondary, yt-bg-teal-1, yt-bg-pastel-pink, …)
   individually — ~100 lines per state. Its own comment already flagged
   an attribute-selector alternative "if all yt-bg-* classes should
   always be covered," so this uses [class^="yt-bg-"] / [class*=" yt-bg-"]
   (same start-of-string-or-preceded-by-space match the yt-btn exclusion
   above already relies on). Same coverage and same rendered result for
   every class in the original list, and it now also covers any future
   yt-bg-* class automatically instead of needing a manual addition.
   --------------------------------------------------------------------------- */

  /* Default state */
  .yourtown [class^="yt-bg-"] a:not([class^="yt-btn"]):not([class*=" yt-btn"]),
  .yourtown
    [class*=" yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]) {
    color: inherit;
    text-decoration: underline;
  }

  /* Hover state */
  .yourtown
    [class^="yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown
    [class^="yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover,
  .yourtown
    [class*=" yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]).hover,
  .yourtown
    [class*=" yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Visited state */
  .yourtown
    [class^="yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):visited,
  .yourtown
    [class*=" yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):visited {
    color: inherit;
  }

  /* Focus-visible state */
  .yourtown
    [class^="yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible,
  .yourtown
    [class*=" yt-bg-"]
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus-visible {
    outline-width: 3px !important;
    outline-style: solid !important;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .yourtown .yt-bg-secondary a.yt-btn-primary:focus-within {
    outline-color: var(--yt-color-white) !important;
  }

  /* ---------------------------------------------------------------------------
   Footer links
   --------------------------------------------------------------------------- */
  .yourtown
    .site-footer-wrapper
    .footer-info
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]) {
    text-decoration: underline;
  }

  .yourtown
    .site-footer-wrapper
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]) {
    color: var(--yt-color-black);
  }

  .yourtown
    .site-footer-wrapper
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):hover,
  .yourtown
    .site-footer-wrapper
    a:not([class^="yt-btn"]):not([class*=" yt-btn"]):focus {
    color: var(--yt-color-black);
    text-decoration: underline;
  }

  .site-footer-wrapper.yourtown .footer-copyright p, .yourtown .site-footer-wrapper .footer-copyright p {
    font-size: 12px;
  }

  /* ---------------------------------------------------------------------------
   External link icon spacing — ::after pseudo-element
   --------------------------------------------------------------------------- */
  body a[target="_blank"]::after {
    margin-right: 8px; /* See TODOs above before merging */
  }

  /* ---------------------------------------------------------------------------
   Back-link block (Employment page)
   Scopes a max-width to the .yt-container ONLY when it wraps this
   specific back-link (matched by exact markup structure + href),
   so other .yt-container instances on the site are unaffected.
   Requires :has() support (all modern evergreen browsers).
   --------------------------------------------------------------------------- */
  .yt-container:has(> .yt-a-rich-text > p > a.back-link) {
    max-width: 1425px;
    margin: 0 auto;
  }

  .yt-a-rich-text p:has(.back-link) {
    margin-bottom: 0;
  }

  /* Base link styling: subtle arrow icon + hover animation */
  .yt-container .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    color: #333;
    text-decoration: none;
    padding: 8px 0;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  @media (min-width: 768px) {
    .yt-container .back-link {
      padding-bottom: 0;
    }
  }

  /* Arrow icon, added via pseudo-element so markup stays untouched */
  .yt-container .back-link::before {
    content: "←";
    font-size: 1.1em;
    transition: transform 0.2s ease;
  }

  /* Hover state: colour shift + arrow nudges left */
  .yt-container .back-link:hover {
    color: #0066cc;
  }

  .yt-container .back-link:hover::before {
    transform: translateX(-4px);
  }

  /* ---------------------------------------------------------------------------
   BDL service related / helpful links — modernised, WCAG 2.2 AA compliant
   !important is required throughout: the base component stylesheet on this
   site loads AFTER custom CSS, so specificity alone won't win the cascade.
   --------------------------------------------------------------------------- */

  /* ===== Related services ===== */

  .bdl-service-related {
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
    margin: 0 !important;
  }

  .bdl-service-related .item,
  .bdl-service-helpful .item.link {
    width: 100% !important;
    position: relative !important;
    display: block !important;
    background-color: #ffffff !important;
    border: 1px solid #dbdeed !important;
    border-left: 4px solid var(--yt-color-primary) !important;
    border-radius: 10px !important;
    padding: 18px 52px 18px 24px !important;
    text-decoration: none !important;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease !important;
    margin-bottom: 1.5em !important;
  }

  .bdl-service-related .item:hover,
  .bdl-service-related .item:focus,
  .bdl-service-helpful .item.link:hover,
  .bdl-service-helpful .item.link:focus {
    background-color: #ffffff !important;
    border-color: #6c3ce0 !important;
    box-shadow: 0 4px 14px rgba(27, 42, 74, 0.1) !important;
  }

  .bdl-service-related .item:focus-visible,
  .bdl-service-helpful .item.link:focus-visible {
    outline: 3px solid #1b2a4a !important;
    outline-offset: 2px !important;
  }

  .bdl-service-related .item .title,
  .bdl-service-helpful .item.link .title {
    color: #1b2a4a !important;
    font-size: 17px !important;
    font-weight: 700 !important;
    margin-bottom: 4px !important;
  }

  .bdl-service-related .item .tag,
  .bdl-service-helpful .item.link .tag {
    color: #4b5565 !important;
    font-size: 14px !important;
    font-weight: 400 !important;
    opacity: 1 !important;
  }

  .bdl-service-related .item::after,
  .bdl-service-helpful .item.link::after {
    content: "" !important;
    position: absolute !important;
    top: 50% !important;
    right: 22px !important;
    width: 9px !important;
    height: 9px !important;
    border-top: 2px solid #6c3ce0 !important;
    border-right: 2px solid #6c3ce0 !important;
    border-bottom: none !important;
    border-left: none !important;
    background: none !important;
    transform: translateY(-50%) rotate(45deg) !important;
    transition: transform 0.15s ease !important;
  }

  .bdl-service-related .item:hover::after,
  .bdl-service-related .item:focus::after,
  .bdl-service-helpful .item.link:hover::after,
  .bdl-service-helpful .item.link:focus::after {
    transform: translateY(-50%) rotate(45deg) translateX(3px) !important;
  }

  /* ===== Helpful links and files ===== */

  .bdl-service-helpful {
    margin-left: 0 !important;
  }

  .bdl-service-helpful .item.link:hover .title,
  .bdl-service-helpful .item.link:focus .title {
    text-decoration: none !important;
  }

  /* 
.bdl-service-helpful .item.link {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  width: 100% !important;
  max-width: fit-content !important;
  min-height: 44px !important;
  padding: 8px 12px 8px 8px !important;
  margin: 0 !important;
  border-radius: 8px !important;
  text-decoration: none !important;
  transition: background-color 0.15s ease !important;
}

.bdl-service-helpful .item.link:hover {
  background-color: #FBEAF3 !important;
}

.bdl-service-helpful .item.link:focus-visible {
  outline: 3px solid #1B2A4A !important;
  outline-offset: 2px !important; /*
}

/* Swap the info-circle glyph for a document icon, sized/positioned to match */
  /* .bdl-service-helpful .item.link::before {
  content: "" !important;
  flex-shrink: 0 !important;
  width: 48px !important;
  height: 48px !important;
