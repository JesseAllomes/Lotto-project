<!-- Shared helper: site_section detection -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    window.ytGetSiteSection = function (el) {
      if (!el) return "body";
      if (el.closest(".yt-o-header, header")) return "header";
      if (el.closest(".site-footer-wrapper, footer")) return "footer";
      return "body";
    };
  })();
</script>

<!-- Logo Click Tracking -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    document.addEventListener(
      "click",
      function (event) {
        const logoLink = event.target.closest(".nav-logo, .logo");
        if (!logoLink) return;

        window.dataLayer.push({
          event: "logo_click",
        });
      },
      true,
    );
  })();
</script>
<!-- End Logo Click Tracking -->

<!-- Menu Navigation Tracking -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    document.addEventListener(
      "click",
      function (event) {
        const link = event.target.closest(
          ".desktop-mega-menu-wrapper a, .mobile-mega-menu-wrapper a",
        );
        if (!link) return;
        if (!link.getAttribute("href")) return;

        const clickText = (link.innerText || link.textContent || "")
          .replace(/\s+/g, " ")
          .trim();

        if (!clickText) return;

        window.dataLayer.push({
          event: "menu_navigation",
          click_text: clickText,
          click_url: link.href,
        });
      },
      true,
    );
  })();
</script>
<!-- End Menu Navigation Tracking -->

<!-- CTA Button / Link Click Tracking -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    const textRules = {
      "my account": "my_account_button_click",
      donate: "donate_button_click",
      "buy tickets": "buy_tickets_button_click",
      "prize draws": "prize_draws_button_click",
      search: "search_link_click",
      "chat with us": "webchat_with_us_button_click",
      "start a webchat": "start_webchat_button_click",
    };

    document.addEventListener(
      "click",
      function (event) {
        const link = event.target.closest("a, button");
        if (!link) return;

        if (link.closest(".item")) return;

        let eventName = null;

        if (link.closest(".yt-btn-search")) {
          eventName = "search_link_click";
        } else {
          const text = (link.innerText || link.textContent || "")
            .trim()
            .replace(/\s+/g, " ")
            .toLowerCase();
          eventName = textRules[text] || null;
        }

        if (!eventName) return;

        window.dataLayer.push({
          event: eventName,
          site_section: window.ytGetSiteSection(link),
        });
      },
      true,
    );
  })();
</script>
<!-- End CTA Button / Link Click Tracking -->

<!-- Store Search Origin Page -->
<script>
  (function () {
    const currentUrl = window.location.href;
    if (!currentUrl.includes("/search")) {
      sessionStorage.setItem("yt_search_origin_page", currentUrl);
    }
  })();
</script>
<!-- End Store Search Origin Page -->

<!-- Search Performed Event -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    function getQuery() {
      const input = document.querySelector(".ais-SearchBox-input");
      return input ? input.value.trim() : "";
    }

    function getResultCount() {
      const stats = document.querySelector(".ais-Stats-text");
      if (!stats) return 0;
      const match = stats.textContent.replace(/,/g, "").match(/(\d+)/);
      return match ? Number(match[1]) : 0;
    }

    function trackSearch() {
      if (!window.location.pathname.toLowerCase().includes("/search")) return;

      const query = getQuery();
      if (!query) return;

      const alreadyTracked = sessionStorage.getItem("yt_last_tracked_query");
      if (alreadyTracked === query) return;
      sessionStorage.setItem("yt_last_tracked_query", query);

      window.dataLayer.push({
        event: "search_performed",
        search_query: query,
        result_count: getResultCount(),
      });
    }

    let debounceTimer;
    function scheduleTrack() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(trackSearch, 700);
    }

    document.addEventListener("input", function (e) {
      if (
        e.target &&
        e.target.matches &&
        e.target.matches(".ais-SearchBox-input")
      ) {
        scheduleTrack();
      }
    });

    scheduleTrack();
  })();
</script>
<!-- End Search Performed Event -->

<!-- Search Result Clicked Event -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    document.addEventListener(
      "click",
      function (event) {
        if (!window.location.pathname.toLowerCase().includes("/search")) return;

        const link = event.target.closest("a");
        if (!link) return;

        const resultItem = link.closest(".ais-Hits-item");
        if (!resultItem) return;

        const searchInput = document.querySelector(".ais-SearchBox-input");
        const query = searchInput ? searchInput.value.trim() : "";
        if (!query) return;

        const results = Array.from(document.querySelectorAll(".ais-Hits-item"));
        const position = results.indexOf(resultItem) + 1;
        const searchOriginPage =
          sessionStorage.getItem("yt_search_origin_page") || "";

        window.dataLayer.push({
          event: "search_result_clicked",
          search_query: query,
          result_position: position,
          result_link: link.href,
          search_origin_page: searchOriginPage,
        });
      },
      true,
    );
  })();
</script>
<!-- End Search Result Clicked Event -->

<!-- Telephone & Email Link Tracking -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    document.addEventListener(
      "click",
      function (event) {
        const link = event.target.closest("a");
        if (!link) return;

        const href = link.getAttribute("href") || "";
        let eventName = "";

        if (href.startsWith("tel:")) {
          eventName = "telephone_link_click";
        } else if (href.startsWith("mailto:")) {
          eventName = "email_link_click";
        }

        if (!eventName) return;

        window.dataLayer.push({
          event: eventName,
          site_section: window.ytGetSiteSection(link),
          click_text: (link.innerText || link.textContent || "").trim(),
          click_url: link.href,
        });
      },
      true,
    );
  })();
</script>
<!-- End Telephone & Email Link Tracking -->

<!-- Video Tracking -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    const trackedPercents = new WeakMap();
    const videoMeta = new WeakMap();

    function formatDuration(totalSeconds) {
      const seconds = Math.round(totalSeconds || 0);
      const m = Math.floor(seconds / 60);
      const s = seconds % 60;
      return m + ":" + String(s).padStart(2, "0");
    }

    function pushVideoEvent(status, iframe, percent) {
      const meta = videoMeta.get(iframe) || {};
      let eventName;
      if (status === "play" && percent === 0) {
        eventName = "video_started";
      } else if (status === "complete") {
        eventName = "video_completed";
      } else {
        eventName = "video_inprogress";
      }
      window.dataLayer.push({
        event: eventName,
        video_duration: meta.duration || "",
        video_percent: percent + "%",
        video_provider: meta.provider || "",
        video_title: meta.title || "",
        video_url: meta.url || "",
        video_status: status,
      });
    }

    function maybeFirePercent(iframe, percent) {
      const fired = trackedPercents.get(iframe) || new Set();
      const milestones = [0, 25, 50, 75, 100];
      const milestone = milestones.filter((m) => percent >= m).pop();
      if (milestone === undefined || fired.has(milestone)) return;
      fired.add(milestone);
      trackedPercents.set(iframe, fired);

      if (milestone === 0) pushVideoEvent("play", iframe, 0);
      else if (milestone === 100) pushVideoEvent("complete", iframe, 100);
      else pushVideoEvent("progress", iframe, milestone);
    }

    function firePause(iframe, percent) {
      pushVideoEvent("pause", iframe, percent);
    }

    function fireResume(iframe, percent) {
      pushVideoEvent("play", iframe, percent);
    }

    function initVimeo() {
      const iframes = document.querySelectorAll(
        'iframe[src*="player.vimeo.com"]',
      );
      if (!iframes.length || !window.Vimeo) return;

      iframes.forEach((iframe) => {
        if (iframe.dataset.ytVideoInit) return;
        iframe.dataset.ytVideoInit = "1";

        const player = new window.Vimeo.Player(iframe);
        videoMeta.set(iframe, { provider: "Vimeo", url: iframe.src });

        Promise.all([player.getVideoTitle(), player.getDuration()]).then(
          ([title, duration]) => {
            const meta = videoMeta.get(iframe) || {};
            meta.title = title;
            meta.duration = formatDuration(duration);
            videoMeta.set(iframe, meta);
          },
        );

        player.on("play", () => {
          Promise.all([player.getCurrentTime(), player.getDuration()]).then(
            ([time, duration]) => {
              const percent = duration ? Math.round((time / duration) * 100) : 0;
              if (percent === 0) {
                maybeFirePercent(iframe, 0);
              } else {
                fireResume(iframe, percent);
              }
            },
          );
        });
        player.on("pause", () => {
          Promise.all([player.getCurrentTime(), player.getDuration()]).then(
            ([time, duration]) => {
              const percent = duration ? Math.round((time / duration) * 100) : 0;
              firePause(iframe, percent);
            },
          );
        });
        player.on("timeupdate", (data) => {
          const percent = Math.round((data.percent || 0) * 100);
          maybeFirePercent(iframe, percent);
        });
        player.on("ended", () => maybeFirePercent(iframe, 100));
      });
    }

    let vimeoSdkLoading = false;
    function loadVimeoSdk(cb) {
      if (window.Vimeo) return cb();
      if (vimeoSdkLoading) return;
      vimeoSdkLoading = true;
      const script = document.createElement("script");
      script.src = "https://player.vimeo.com/api/player.js";
      script.onload = cb;
      document.head.appendChild(script);
    }

    function initYouTube() {
      const iframes = document.querySelectorAll(
        'iframe[src*="youtube.com/embed"]',
      );
      if (!iframes.length || !window.YT || !window.YT.Player) return;

      iframes.forEach((iframe) => {
        if (iframe.dataset.ytVideoInit) return;
        iframe.dataset.ytVideoInit = "1";

        videoMeta.set(iframe, { provider: "YouTube", url: iframe.src });

        let pollTimer = null;

        new window.YT.Player(iframe, {
          events: {
            onReady: (e) => {
              const data = e.target.getVideoData();
              const meta = videoMeta.get(iframe) || {};
              meta.title = data && data.title;
              meta.duration = formatDuration(e.target.getDuration());
              videoMeta.set(iframe, meta);
            },
            onStateChange: (e) => {
              if (e.data === window.YT.PlayerState.PLAYING) {
                const duration = e.target.getDuration();
                const percent = duration
                  ? Math.round((e.target.getCurrentTime() / duration) * 100)
                  : 0;
                if (percent === 0) {
                  maybeFirePercent(iframe, 0);
                } else {
                  fireResume(iframe, percent);
                }
                clearInterval(pollTimer);
                pollTimer = setInterval(() => {
                  const duration = e.target.getDuration();
                  if (!duration) return;
                  const percent = Math.round(
                    (e.target.getCurrentTime() / duration) * 100,
                  );
                  maybeFirePercent(iframe, percent);
                }, 1000);
              } else if (e.data === window.YT.PlayerState.PAUSED) {
                const duration = e.target.getDuration();
                const percent = duration
                  ? Math.round((e.target.getCurrentTime() / duration) * 100)
                  : 0;
                firePause(iframe, percent);
                clearInterval(pollTimer);
              } else if (e.data === window.YT.PlayerState.ENDED) {
                maybeFirePercent(iframe, 100);
                clearInterval(pollTimer);
              } else {
                clearInterval(pollTimer);
              }
            },
          },
        });
      });
    }

    let youtubeSdkLoading = false;
    function loadYouTubeSdk(cb) {
      if (window.YT && window.YT.Player) return cb();
      if (youtubeSdkLoading) return;
      youtubeSdkLoading = true;
      window.onYouTubeIframeAPIReady = cb;
      const script = document.createElement("script");
      script.src = "https://www.youtube.com/iframe_api";
      document.head.appendChild(script);
    }

    function scan() {
      if (document.querySelector('iframe[src*="player.vimeo.com"]')) {
        loadVimeoSdk(initVimeo);
      }
      if (document.querySelector('iframe[src*="youtube.com/embed"]')) {
        loadYouTubeSdk(initYouTube);
      }
    }

    new MutationObserver(scan).observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
    document.addEventListener("DOMContentLoaded", scan);
    scan();
  })();
</script>
<!-- End Video Tracking -->

<!-- Form Tracking -->
<script>
  (function () {
    window.dataLayer = window.dataLayer || [];

    const startedForms = new WeakSet();
    const initedForms = new WeakSet();
    const initedFields = new WeakSet();

    function isVisible(el) {
      return !!(
        el.offsetWidth ||
        el.offsetHeight ||
        el.getClientRects().length
      );
    }

    function getFieldLabel(field) {
      const fieldset = field.closest("fieldset, .Form__Element");
      const legend =
        fieldset &&
        (fieldset.querySelector("legend") ||
          fieldset.querySelector(
            ".FormTextbox__Label, .Form__Element__Caption",
          ));
      if ((field.type === "radio" || field.type === "checkbox") && legend) {
        return legend.textContent
          .replace(/\*/g, "")
          .replace(/\(required\)/gi, "")
          .trim();
      }
      const label =
        field.id && document.querySelector('label[for="' + field.id + '"]');
      if (label) {
        return label.textContent
          .replace(/\*/g, "")
          .replace(/\(required\)/gi, "")
          .trim();
      }
      if (legend) {
        return legend.textContent
          .replace(/\*/g, "")
          .replace(/\(required\)/gi, "")
          .trim();
      }
      return field.name || field.id || field.type;
    }

    function getFieldValue(field) {
      if (field.type === "email") return "[EMAIL_ENTERED]";
      if (field.type === "password") return "[PASSWORD_ENTERED]";
      if (field.type === "checkbox" || field.type === "radio") {
        return field.checked ? "Checked" : "Unchecked";
      }
      return field.value;
    }

    function formName(form) {
      const labelledBy = form.getAttribute("aria-labelledby");
      if (labelledBy) {
        const label = document.getElementById(labelledBy);
        if (label && label.textContent.trim()) return label.textContent.trim();
      }
      return (
        form.getAttribute("data-form-name") ||
        form.getAttribute("name") ||
        form.id ||
        "Unnamed form"
      );
    }

    function pushFormEvent(eventName, form, extra) {
      window.dataLayer.push(
        Object.assign(
          {
            event: eventName,
            form_id: form.id || "",
            form_name: formName(form),
          },
          extra || {},
        ),
      );
    }

    function getUniqueVisibleFields(form) {
      const all = Array.from(
        form.querySelectorAll('input:not([type="hidden"]), select, textarea'),
      ).filter(isVisible);
      const seenRadioGroups = new Set();
      return all.filter((field) => {
        if (field.type !== "radio") return true;
        if (seenRadioGroups.has(field.name)) return false;
        seenRadioGroups.add(field.name);
        return true;
      });
    }

    function getFieldContext(form, field) {
      const visibleFields = getUniqueVisibleFields(form);
      const key =
        field.type === "radio" || field.type === "checkbox"
          ? field.name
          : field;
      let step =
        visibleFields.findIndex((f) => {
          const fKey = f.type === "radio" || f.type === "checkbox" ? f.name : f;
          return fKey === key;
        }) + 1;
      if (step === 0) step = visibleFields.length + 1;
      return { step: step, length: visibleFields.length };
    }

    const validityCheckInProgress = new WeakSet();

    function handleSubmitAttempt(form) {
      if (validityCheckInProgress.has(form)) return;
      validityCheckInProgress.add(form);
      const fields = getUniqueVisibleFields(form);
      const validityResults = fields.map((field) => field.checkValidity());
      if (validityResults.every(Boolean)) {
        pushFormEvent("form_submit", form);
      }
      setTimeout(() => validityCheckInProgress.delete(form), 0);
    }

    function initField(form, field) {
      if (initedFields.has(field)) return;
      initedFields.add(field);

      field.addEventListener("focus", function () {
        if (!startedForms.has(form)) {
          startedForms.add(form);
          pushFormEvent("form_start", form);
        }
      });

      field.addEventListener("change", function () {
        const ctx = getFieldContext(form, field);
        pushFormEvent("form_activity", form, {
          form_field_name: getFieldLabel(field),
          form_field_step: ctx.step,
          form_length: ctx.length,
          form_field_value: getFieldValue(field),
        });
      });

      field.addEventListener("invalid", function () {
        if (!isVisible(field)) return;
        const ctx = getFieldContext(form, field);
        pushFormEvent("form_error", form, {
          form_field_name: getFieldLabel(field),
          form_field_step: ctx.step,
          form_error_message: field.validationMessage || "Validation failed",
        });
      });
    }

    function initForm(form) {
      if (!initedForms.has(form)) {
        initedForms.add(form);
        form.addEventListener(
          "submit",
          function () {
            handleSubmitAttempt(form);
          },
          true,
        );
        form.addEventListener(
          "click",
          function (e) {
            const submitControl = e.target.closest(
              'button[type="submit"], input[type="submit"]',
            );
            if (submitControl) handleSubmitAttempt(form);
          },
          true,
        );
      }

      const allFields = Array.from(
        form.querySelectorAll('input:not([type="hidden"]), select, textarea'),
      );
      allFields.forEach((field) => initField(form, field));
    }

    function scanForms() {
      document.querySelectorAll("form").forEach(initForm);
    }

    new MutationObserver(scanForms).observe(document.documentElement, {
      childList: true,
      subtree: true,
    });
    document.addEventListener("DOMContentLoaded", scanForms);
    scanForms();
  })();
</script>
<!-- End Form Tracking --></head>
<body class="yourtown">
<!-- -------------------------------------------------------------------------
     Back to top — HTML
     Place before closing </body> tag on implementation.
     aria-label removed — visible text serves as the accessible name.
     -------------------------------------------------------------------------- -->
<button class="back-to-top">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
  <span>Back to Top</span>
</button>

<!-- Recite Me Accessibility Toolbar -->
<script
  src="https://cdn.reciteme.com/reciteme_toolbar_launcher.min.js"
  data-clientid="3cf587ae3cf3511035d1f874671efe8b83d93dbf"
  data-location="au"

  data-button-toolbar-background-color="#3a427e"
  data-button-toolbar-foreground-color="#ffffff">
</script>


<!-- -------------------------------------------------------------------------
     Back to top — JavaScript
     scrollThreshold: distance in px before button appears (default 300).
     Smooth scroll is handled via scrollTo with behavior: 'smooth'.
     -------------------------------------------------------------------------- -->
<script>
  (function () {
    const btn = document.querySelector('.back-to-top');
    const scrollThreshold = 300; // px — adjust as needed

    if (!btn) return;

    // Show/hide on scroll
    window.addEventListener('scroll', function () {
      if (window.scrollY > scrollThreshold) {
        btn.classList.add('is-visible');
      } else {
        btn.classList.remove('is-visible');
      }
    }, { passive: true });

    // Scroll to top on click
    btn.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Keyboard: also handle Enter and Space for completeness
    // (native <button> handles this already, but explicit for clarity)
    btn.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

  }());

(function () {
  function initSkipLinks() {
    var targets = [
      { selector: '.yt-o-header.combined-nav-wrapper', id: 'site-header'  },
      { selector: 'main',                              id: 'main-content' },
      { selector: '.site-footer-wrapper',              id: 'site-footer'  },
    ];

    targets.forEach(function (item) {
      var el = document.querySelector(item.selector);
      if (el) {
        el.id = item.id;
        el.setAttribute('tabindex', '-1');
      }
    });

    var nav = document.createElement('nav');
    nav.setAttribute('aria-label', 'Skip links');
    nav.className = 'skip-links';
    nav.innerHTML = [
      '<a href="#site-header"  class="skip-link">Skip to navigation</a>',
      '<a href="#main-content" class="skip-link">Skip to main content</a>',
      '<a href="#site-footer"  class="skip-link">Skip to footer</a>',
    ].join('');

    document.body.prepend(nav);
  }

  // Run immediately if DOM is ready, otherwise defer
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSkipLinks);
  } else {
    initSkipLinks();
  }
}());
</script>
    

